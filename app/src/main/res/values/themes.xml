<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Horizon" parent="android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:fontFamily">monospace</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/horizon_background</item>
        <item name="android:navigationBarColor">@color/horizon_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/horizon_background</item>
    </style>

    <style name="Theme.Horizon.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/horizon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/horizon_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Horizon</item>
    </style>
</resources>
