++    private fun sequenceGaps(observations: List<ObservationEntity>): Int {
++        val seq = observations.map { it.sequenceNumber }.sorted()
++        if (seq.isEmpty()) return 0
++        var gaps = 0
++        var expected = seq.first()
++        seq.forEach {
++            if (it != expected) gaps++
++            expected = it + 1
++        }
++        return gaps
++    }
