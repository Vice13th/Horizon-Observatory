+@Composable
+private fun SkyPlot(points: List<SatellitePoint>) {
+    Card(colors = CardDefaults.cardColors(containerColor = Color(0xFF17121D))) {
+        Column(Modifier.padding(14.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Text("SATELLITE SKY PLOT", style = MaterialTheme.typography.titleMedium)
+            Text("Based only on observed azimuth/elevation from GnssStatus • ${points.size} plotted satellites", style = MaterialTheme.typography.labelSmall)
+            Box(Modifier.fillMaxWidth().height(250.dp).background(Color(0xFF0D0B10))) {
+                Canvas(Modifier.fillMaxSize().padding(12.dp)) {
+                    val diameter = min(size.width, size.height) * 0.82f
+                    val radius = diameter / 2f
+                    val center = Offset(size.width / 2f, size.height / 2f)
+                    val ringFractions = floatArrayOf(1f, 2f / 3f, 1f / 3f)
+                    ringFractions.forEach { fraction ->
+                        drawCircle(Color(0xFF3A3042), radius * fraction, center, style = androidx.compose.ui.graphics.drawscope.Stroke(width = 1.5f))
                     }
+                    drawLine(Color(0xFF3A3042), Offset(center.x - radius, center.y), Offset(center.x + radius, center.y), 1.2f)
+                    drawLine(Color(0xFF3A3042), Offset(center.x, center.y - radius), Offset(center.x, center.y + radius), 1.2f)
+
+                    points.forEach { sat ->
+                        val radial = radius * ((90.0 - sat.elevationDeg.coerceIn(0.0, 90.0)) / 90.0).toFloat()
+                        val az = Math.toRadians(sat.azimuthDeg)
+                        val x = center.x + radial * sin(az).toFloat()
+                        val y = center.y - radial * cos(az).toFloat()
+                        drawCircle(
+                            color = if (sat.usedInFix) Color(0xFFE1A4FF) else Color(0xFF8A7A92),
+                            radius = 5.5f,
+                            center = Offset(x, y)
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
